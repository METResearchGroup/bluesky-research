# Copy to .env in the repository root and fill in real values.
# Do not commit .env.

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# local | test | prod (see lib/load_env_vars.py)
RUN_MODE=local
ENVIRONMENT=local

# ------------------------------------------------------------------------------
# Bluesky account (local/prod when not using Secrets Manager)
# ------------------------------------------------------------------------------
# BLUESKY_HANDLE=
# BLUESKY_PASSWORD=
# DEV_BLUESKY_HANDLE=
# DEV_BLUESKY_PASSWORD=
# BSKY_DATA_DIR=

# ------------------------------------------------------------------------------
# API keys — integrations and ML
# ------------------------------------------------------------------------------
# Perspective API (toxicity / constructiveness classifiers)
GOOGLE_API_KEY=

# OpenAI and LLM tooling
OPENAI_API_KEY=

# Google AI / Gemini (optional workflows)
GOOGLE_AI_STUDIO_KEY=

# Hugging Face (models, embeddings)
HF_TOKEN=

# Optional news and LLM providers (used by some tooling paths)
NYTIMES_KEY=
NEWSAPI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# AWS (S3, Athena, etc.) — use SSO/profile or static keys as appropriate
# ------------------------------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_PROFILE_NAME=

# ------------------------------------------------------------------------------
# Storage and observability (optional)
# ------------------------------------------------------------------------------
MONGODB_URI=
LANGTRACE_API_KEY=
COMET_API_KEY=

# ------------------------------------------------------------------------------
# Feed API (feed_api/) — Bluesky feed generator deployment
# ------------------------------------------------------------------------------
# Public hostname and DID for the generator (see feed_api/config.py)
# HOSTNAME=
# SERVICE_DID=
# PORT=8000
# HOST=127.0.0.1
